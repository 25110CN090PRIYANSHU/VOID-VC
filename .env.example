PORT=5000
MONGO_URI=
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://your-render-service.onrender.com

# OPTION A: Metered automatic ICE config (recommended)
# Create a TURN credential in Metered, then copy its app name and API key.
# The server fetches the current ICE server list; do NOT put your Metered secret key in the browser.
METERED_APP_NAME=your-metered-app-name
METERED_API_KEY=your-turn-credential-api-key
METERED_REGION=standard

# OPTION B: Static TURN credentials (use this if you don't use METERED_API_KEY)
# Only use TURN URLs here. Do not put stun: URLs in TURN_URLS.
TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:80?transport=tcp,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-password
